# Copy this file to keystore.properties and fill it in with your own values.
#
# keystore.properties is ignored by git on purpose. It holds the passwords to the
# key that signs published builds: anyone who has them can ship an update that
# phones will accept as genuine. Keep it off shared drives and out of backups that
# other people can read.
#
# Create the key itself with (it will ask for the passwords interactively):
#
#   keytool -genkeypair -v -keystore cifra-release.jks \
#           -alias cifra -keyalg RSA -keysize 4096 -validity 10000
#
# Store the .jks file somewhere safe and back it up. If you lose it you can never
# update the published app again - it would have to be listed afresh under a new
# name, and existing users would not get updates.

storeFile=cifra-release.jks
storePassword=
keyAlias=cifra
keyPassword=
