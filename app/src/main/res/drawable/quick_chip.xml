<?xml version="1.0" encoding="utf-8"?>
<!--
  A category shortcut. A quiet outline until it is pressed, so a row of six of
  them reads as a row of choices rather than a row of grey slabs.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2F8F63" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- the one chosen stays filled, so the screen says what it is about to save -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2F8F63" />
            <stroke android:width="1dp" android:color="#FF45B87E" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
