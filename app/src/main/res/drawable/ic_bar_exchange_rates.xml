<?xml version="1.0" encoding="utf-8"?>
<!--
  Exchange rates: two arrows going opposite ways, which is what changing one
  currency into another is. The old button was a photograph of a bar chart at
  16 pixels across, and at arm's length it was a grey smudge.

  Bar weight, like the other buttons down there: 24 across, stroke 2.2, round
  ends, plain white for the button to tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- top: away to the right -->
    <path
        android:pathData="M4,9 L19,9"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M15.5,5.5 L19,9 L15.5,12.5"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />

    <!-- bottom: back to the left -->
    <path
        android:pathData="M20,15 L5,15"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
    <path
        android:pathData="M8.5,11.5 L5,15 L8.5,18.5"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2" />
</vector>
