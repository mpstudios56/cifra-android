<?xml version="1.0" encoding="utf-8"?>
<!--
  Bar button background: a rounded square with a ripple. It was a hard-edged
  rectangle with no touch feedback at all, which is what made the bar look its
  age more than the icons did.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/holo_dark_button" />
        </shape>
    </item>
</ripple>
