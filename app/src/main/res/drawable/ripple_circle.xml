<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark left by a finger on a round button.

  Android's borderless one spreads as far as it likes: on a button of forty-odd
  points it drew a circle wider than the button, cut off by whatever it ran into
  and centred on nothing in particular. This one is held to a circle inside the
  button, so it is round, whole, and where the finger was.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
