<?xml version="1.0" encoding="utf-8"?>
<!--
  A control you can act on: a soft outline instead of the platform's underline,
  which at this size read as a scratch under the words.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="#14FFFFFF" />
    <stroke android:width="1dp" android:color="#24FFFFFF" />
</shape>
