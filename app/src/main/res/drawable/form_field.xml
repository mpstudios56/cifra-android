<?xml version="1.0" encoding="utf-8"?>
<!--
  A control you can act on: a soft outline instead of the platform's underline,
  which at this size read as a scratch under the words, and the chevron at the
  end. Without the chevron the box looks like a label rather than a menu - the
  custom background takes the platform's own arrow away with it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:gravity="end|center_vertical"
        android:end="10dp"
        android:drawable="@drawable/ic_chevron_down" />
</layer-list>
