  ~
  ~ A rounded chip in the app's own greens, rather than the four bevelled
  ~ bitmaps it used to be. It is the one figure on the screen that is a button,
  ~ so it should look like one without shouting over the list beside it.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2F8F63" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF243B33" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#FF3FA96F" />
        </shape>
    </item>
</selector>
