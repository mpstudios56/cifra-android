<?xml version="1.0" encoding="utf-8"?>
<!--
  Top edge of the quick menu bubble. Was a 30x15 pixel nine-patch that only
  existed at mdpi and hdpi, so it was blown up four times on a modern screen and
  came out soft. A shape has no intrinsic size, hence the explicit height that
  the bitmap used to provide.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size android:height="12dp" />
    <solid android:color="@color/quick_action_surface" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp" />
</shape>
