        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M5.9,5.6 L18.1,5.6 A2.4,2.4 0 0,1 20.5,8 L20.5,16 A2.4,2.4 0 0,1 18.1,18.4 L5.9,18.4 A2.4,2.4 0 0,1 3.5,16 L3.5,8 A2.4,2.4 0 0,1 5.9,5.6 Z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M20.5,10.4 L17.2,10.4 A1.6,1.6 0 0,0 17.2,13.6 L20.5,13.6" />
</vector>
