<!--
  Income or expense, on a new category.
  It was the platform button of 2010 with a picture inside it: a grey slab with
  a shadow, next to a field drawn this year.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#334CAF7D" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#804CAF7D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33E5484D" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#80E5484D" />
        </shape>
    </item>
</selector>
