<?xml version="1.0" encoding="utf-8"?>
<!--
  menu tab icon for Cifra. One outline set at a single stroke weight, replacing
  bitmaps that only existed up to hdpi and were upscaled on modern screens.
  Literal colours, not resource references: build-time PNG generation cannot
  resolve those. The tab strip tints it for the selected and normal states.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M4.2,7 L19.8,7" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M4.2,12 L19.8,12" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M4.2,17 L19.8,17" />
</vector>
