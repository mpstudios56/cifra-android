<?xml version="1.0" encoding="utf-8"?>
<!--
  A key on the calculator, the same circle as the quick entry keypad and the
  unlock keypad. They are the same gesture - a digit typed with a thumb - and
  used to look like three different programs.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF2F8F63" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
