<?xml version="1.0" encoding="utf-8"?>
<!--
  A filled disc, meant to be tinted with somebody's colour.

  The dots were drawn with circle.xml, which is an outline: its fill is
  transparent and it carries a tint of its own that overrides whatever colour
  is set on it. So every dot in the app - beside a name, on a shared account -
  was an invisible ring. This is a plain solid circle and nothing else.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFFFF" />
</shape>
