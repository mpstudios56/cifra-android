<?xml version="1.0" encoding="utf-8"?>
<!--
  actionbar_quick_add for Cifra. Part of one outline set at a single stroke weight.
  A bolt rather than another plus: the ordinary add button is already a plus, and
  what this one promises is speed, not a different kind of entry.
  Literal colours, not resource references: build-time PNG generation cannot
  resolve those. The views that show these tint them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M13.6,2.6 L5.6,13.4 H11.2 L10.4,21.4 L18.4,10.6 H12.8 Z" />
</vector>
