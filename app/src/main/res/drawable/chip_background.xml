<!--
  A suggested category: a pill, not a slab.
  These were plain platform buttons in a row, each with its own grey box and
  its shadow, which is the oldest-looking thing left in the app.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#334CAF7D" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#804CAF7D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#40F4EFE4" />
        </shape>
    </item>
</selector>
