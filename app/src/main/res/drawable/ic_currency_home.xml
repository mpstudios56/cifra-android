<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark against the currency everything else is converted into. A house,
  because that is what it is called - the home currency - and because a house
  is read without a caption.

  Green, the app's own, so it registers as a state and not as a button; menu
  weight, 24 across, stroke 1.7, round ends. It replaces a photographic green
  house from 2010 that sat at the wrong size next to modern text.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#00000000"
        android:pathData="M4,10.5 L12,4 L20,10.5"
        android:strokeColor="#FF45B87E"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <path
        android:fillColor="#00000000"
        android:pathData="M6,9.6 L6,19 L18,19 L18,9.6"
        android:strokeColor="#FF45B87E"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <!-- the door, filled: it keeps the shape readable at list size -->
    <path
        android:fillColor="#FF45B87E"
        android:pathData="M10.4,19 L10.4,13.6 L13.6,13.6 L13.6,19 Z" />
</vector>
