<?xml version="1.0" encoding="utf-8"?>
<!--
  Two things that are one thing: two rings overlapping, with the overlap drawn
  solid. Not a funnel, not a folder, not two arrows - what is being done here is
  folding a repeated row into the one it repeats, and two rings sharing a middle
  is the picture everyone already knows for that.

  Drawn at bar weight - 24 across, stroke 2.2, plain white - so it carries the
  same as the plus beside it. At the lighter menu weight it looked washed out
  next to its neighbours.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#00000000"
        android:pathData="M9,12m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2" />

    <path
        android:fillColor="#00000000"
        android:pathData="M15,12m-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2" />

    <!-- the part they share, filled: that is the row that stays -->
    <path
        android:fillAlpha="0.95"
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8 A5,5 0 0,1 12,16 A5,5 0 0,1 12,8 Z" />
</vector>
