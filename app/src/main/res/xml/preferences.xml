      Denis Solonenko - initial API and implementation

  Grouped by what a setting is for, not by when it was added. The old screen had
  a catch-all "interface" section holding the language, the tabs, the week start
  and the fiscal year; the two halves of the widget in separate places; and an
  "other" section for whatever had nowhere else to go.

  Dropbox and Google Drive stay as sections rather than becoming sub-screens:
  PreferenceFragment looks their keys up by name without checking for null, so a
  sub-screen would make those lookups fail the moment it was opened.
-->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:layout="@layout/preference_category_bullet" android:title="@string/pref_group_appearance">
        <ListPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="default"
            android:entries="@array/ui_language_entities"
            android:entryValues="@array/ui_language_values"
            android:key="ui_language"
            android:summary="@string/ui_language_summary"
            android:title="@string/ui_language" />
        <ListPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="BLOTTER"
            android:entries="@array/startup_screen_entities"
            android:entryValues="@array/startup_screen_values"
            android:key="startup_screen"
            android:summary="@string/startup_screen_summary"
            android:title="@string/startup_screen" />
        <!--
          Whether the screen turns with the phone. Kept here rather than left to
          the phone's own switch: somebody entering the week's shopping lying
          down does not want the list swinging round every time they move.
        -->
        <ListPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="PHONE"
            android:entries="@array/screen_rotation_entities"
            android:entryValues="@array/screen_rotation_values"
            android:key="screen_rotation"
            android:summary="@string/screen_rotation_summary"
            android:title="@string/screen_rotation" />
        <CheckBoxPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="true"
            android:key="show_summary_tab"
            android:summary="@string/show_summary_tab_summary"
            android:title="@string/show_summary_tab" />
        <ListPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="MONTH"
            android:entries="@array/summary_period_entries"
            android:entryValues="@array/summary_period_values"
            android:key="summary_period"
            android:summary="@string/summary_period_summary"
            android:title="@string/summary_period" />
        <CheckBoxPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="true"
            android:key="templates_as_tab"
            android:summary="@string/templates_as_tab_summary"
            android:title="@string/templates_as_tab" />
        <CheckBoxPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="true"
            android:key="show_budgets_tab"
            android:summary="@string/show_budgets_tab_summary"
            android:title="@string/show_budgets_tab" />
        <CheckBoxPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="true"
            android:key="show_reports_tab"
            android:summary="@string/show_reports_tab_summary"
            android:title="@string/show_reports_tab" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/preference_category_bullet" android:title="@string/pref_group_transactions">
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:summary="@string/transaction_screen_summary"
            android:title="@string/transaction_screen"
            app:fragment="io.github.mpstudios56.cifra.preference.TransactionPreferencesFragment" />
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:summary="@string/blotter_screen_summary"
            android:title="@string/blotter_screen"
            app:fragment="io.github.mpstudios56.cifra.preference.BlotterPreferencesFragment" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="true"
            android:key="treat_transfer_to_ccard_as_payment"
            android:summary="@string/treat_transfer_to_ccard_as_payment_summary"
            android:title="@string/treat_transfer_to_ccard_as_payment" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="true"
            android:key="restore_missed_scheduled_transactions"
            android:summary="@string/restore_missed_scheduled_transactions_summary"
            android:title="@string/restore_missed_scheduled_transactions" />
    </PreferenceCategory>


    <PreferenceCategory android:layout="@layout/preference_category_bullet" android:title="@string/pref_group_widgets">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="true"
            android:key="quick_entry_from_widget"
            android:summary="@string/quick_entry_from_widget_summary"
            android:title="@string/quick_entry_from_widget" />
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="false"
            android:key="quick_bar_enabled"
            android:summary="@string/quick_bar_summary"
            android:title="@string/quick_bar" />
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:key="shortcut_new_transaction"
            android:summary="@string/shortcut_summary"
            android:title="@string/shortcut_new_transaction" />
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:key="shortcut_new_transfer"
            android:summary="@string/shortcut_summary"
            android:title="@string/shortcut_new_transfer" />
    </PreferenceCategory>

    <!--
      Sharing used to live here, as three rows among forty. It is a thing the
      app does, not a preference, and buried in this list nobody found it; it
      has a screen of its own in the menu now. The backup settings went the
      same way, into the backup menu beside the buttons that use them.
    -->

</androidx.preference.PreferenceScreen>
