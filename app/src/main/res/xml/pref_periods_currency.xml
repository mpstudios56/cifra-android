<?xml version="1.0" encoding="utf-8"?>
<!--
  The week, the fiscal year and where the rates come from. They lived in
  the settings, three screens away from the currencies they are about.
-->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="cat_period"
        android:layout="@layout/preference_category_bullet"
        android:title="@string/section_period">

    <ListPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="0"
            android:entries="@array/first_day_of_week_entries"
            android:entryValues="@array/first_day_of_week_values"
            android:key="first_day_of_week"
            android:summary="@string/first_day_of_week_summary"
            android:title="@string/first_day_of_week" />
    <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:key="fiscal_year_start"
            android:summary="@string/fiscal_year_start_summary"
            android:title="@string/fiscal_year_start" />
        </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_currencies"
        android:layout="@layout/preference_category_bullet"
        android:title="@string/section_currencies_rates">

        <!--
          The two lists themselves. Their summary says what is set, so the
          screen answers "which currencies do I have" without being entered.
        -->
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:key="open_currencies"
            android:title="@string/currencies" />

        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:key="open_rates"
            android:title="@string/exchange_rates" />

<ListPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:defaultValue="freeCurrency"
            android:entries="@array/exchange_rate_provider_entities"
            android:entryValues="@array/exchange_rate_provider_values"
            android:key="exchange_rate_provider"
            android:summary="@string/exchange_rate_provider_summary"
            android:title="@string/exchange_rate_provider" />
    <EditTextPreference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            android:enabled="false"
            android:key="openexchangerates_app_id"
            android:summary="@string/openexchangerates_app_id_summary"
            android:title="@string/openexchangerates_app_id" />
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
