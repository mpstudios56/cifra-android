<!--
  The lock, on its own screen, reached from the menu beside backup and restore:
  keeping the data safe and keeping a copy of it are the same worry, and the PIN
  used to be six taps deep in a screen nobody opens twice.
-->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="cat_protection"
        android:layout="@layout/preference_category_bullet"
        android:title="@string/protection">


        <!--
          Off out of the box. Blocking screenshots protects a screen full of
          somebody's money, which is the right instinct - but it also stops the
          person using it from photographing a fault to report it, and a fault
          nobody can show is a fault nobody fixes. Whoever wants the block can
          have it in one tap; whoever wants to send a picture does not have to
          go looking for a setting first.
        -->


    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
