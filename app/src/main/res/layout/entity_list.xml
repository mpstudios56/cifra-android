<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="fill_parent"
    a:layout_height="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:orientation="vertical"
    a:id="@+id/entity_list">

    <!--
      The box that narrows the list as one types. It carried an English line
      left in by whoever wrote it, and the platform’s blue underline - the
      only blue in the app.
    -->
    <EditText
        a:id="@+id/searchFilter"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginStart="12dp"
        a:layout_marginTop="8dp"
        a:layout_marginEnd="12dp"
        a:layout_marginBottom="4dp"
        a:background="@drawable/field_background"
        a:hint="@string/search_hint"
        a:inputType="text"
        a:maxLines="1"
        a:paddingStart="14dp"
        a:paddingTop="12dp"
        a:paddingEnd="14dp"
        a:paddingBottom="12dp"
        a:textColor="#FFF4EFE4"
        a:textColorHint="#8CF4EFE4"
        a:textSize="16sp" />
    
    <ListView
        a:id="@android:id/list"
        a:fastScrollEnabled="true"
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:layout_weight="1" />

    <TextView
        a:id="@id/android:empty"
        a:layout_width="fill_parent"
        a:layout_height="wrap_content"
        a:gravity="center"
        a:text="@string/no_projects"
        a:layout_weight="1" />

    <androidx.constraintlayout.widget.ConstraintLayout style="@style/BottomBar">
        <ImageButton
            a:id="@+id/bAdd"
            style="@style/BottomBarButton"
            a:src="@drawable/actionbar_add_big"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!--
          The order of the list, decided here rather than in the settings: it
          belongs to the list somebody is looking at, and each of these lists
          wants its own answer.
        -->
        <ImageButton
            a:id="@+id/bSort"
            style="@style/BottomBarButton"
            a:src="@drawable/ic_sort"
            a:layout_marginRight="@dimen/action_button_margin"
            app:layout_constraintEnd_toStartOf="@id/bMerge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            a:id="@+id/bMerge"
            style="@style/BottomBarButton"
            a:src="@drawable/cell_merge"
            a:layout_marginRight="@dimen/action_button_margin"
            app:layout_constraintEnd_toStartOf="@id/bSelect"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            a:id="@+id/bSelect"
            style="@style/BottomBarButton"
            a:src="@drawable/select_check_box"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
