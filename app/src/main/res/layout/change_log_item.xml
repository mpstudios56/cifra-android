<?xml version="1.0" encoding="utf-8"?>
<!--
  One change: what it was, what was done to it, and by whom. Same shape as a
  settings row - the thing itself on top, the explaining underneath in smaller
  type.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/change_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/ListPrimary" />

        <TextView
            android:id="@+id/change_what"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:alpha="0.75"
            android:singleLine="true"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/change_who"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:singleLine="true"
        android:textSize="12sp" />
</LinearLayout>
