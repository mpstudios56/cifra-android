<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qif_export_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/FormSection"
                android:layout_marginTop="0dp"
                android:text="@string/period" />

            <TextView
                style="@style/FormSectionNote"
                android:text="@string/csv_export_period_note" />

            <Button
                android:id="@+id/bPeriod"
                style="@style/FormButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/FormSection"
                android:text="@string/accounts" />

            <TextView
                style="@style/FormSectionNote"
                android:text="@string/qif_export_accounts_note" />

            <Button
                android:id="@+id/bAccounts"
                style="@style/FormButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_accounts" />

            <TextView
                style="@style/FormSection"
                android:text="@string/csv_import_shape" />

            <TextView
                style="@style/FormSectionNote"
                android:text="@string/csv_export_shape_note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/decimals" />

                    <Spinner
                        android:id="@+id/spinnerDecimals"
                        style="@style/FormSpinner"
                        android:entries="@array/decimals"
                        android:theme="@style/Monospaced" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/decimal_separator" />

                    <Spinner
                        android:id="@+id/spinnerDecimalSeparators"
                        style="@style/FormSpinner"
                        android:entries="@array/decimal_separators"
                        android:theme="@style/Monospaced" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/group_separator" />

                    <Spinner
                        android:id="@+id/spinnerGroupSeparators"
                        style="@style/FormSpinner"
                        android:entries="@array/group_separators"
                        android:theme="@style/Monospaced" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FormFieldLabel"
                android:text="@string/date_format" />

            <Spinner
                android:id="@+id/spinnerDateFormats"
                style="@style/FormSpinner"
                android:entries="@array/date_format_values"
                android:theme="@style/Monospaced" />

            <CheckBox
                android:id="@+id/checkboxUseCurrencyDecimals"
                style="@style/FormCheckBox"
                android:text="@string/export_use_currency_specific_decimals" />

            <TextView
                style="@style/FormSection"
                android:text="@string/csv_export_where" />

            <TextView
                style="@style/FormSectionNote"
                android:text="@string/csv_export_where_note" />

            <CheckBox
                android:id="@+id/checkboxUploadToDropbox"
                style="@style/FormCheckBox"
                android:text="@string/upload_to_dropbox" />

            <CheckBox
                android:id="@+id/checkboxUploadToGDrive"
                style="@style/FormCheckBox"
                android:text="@string/upload_to_gdrive" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/ok_cancel_buttons" />
</LinearLayout>
