<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="?android:attr/listPreferredItemHeight"
    android:paddingLeft="0dip" android:paddingRight="12dip">
    <TextView android:id="@+id/indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="fill_parent"
        android:layout_width="3dp"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="3dp"
        android:layout_marginTop="3dp"/>
    <TextView android:id="@+id/indent"
        app:layout_constraintStart_toEndOf="@id/indicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:singleLine="true" android:gravity="center_vertical"
        android:text="" android:ellipsize="marquee"/>
    <ImageView android:id="@+id/span"
        app:layout_constraintStart_toEndOf="@id/indent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_alignParentBottom="true"
        android:src="@drawable/expander_ic_minimized"
        android:layout_marginTop="8dp" />
    <!--
      The symbol, between the expander and the name. Absent categories keep the
      space, so the names stay in a column instead of stepping in and out
      depending on which rows happen to have been given a picture.
    -->
    <ImageView android:id="@+id/category_icon"
        app:layout_constraintStart_toEndOf="@id/span"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null" />
    <!-- The same slot, for somebody who typed an emoji instead of choosing. -->
    <TextView android:id="@+id/category_icon_text"
        app:layout_constraintStart_toStartOf="@id/category_icon"
        app:layout_constraintEnd_toEndOf="@id/category_icon"
        app:layout_constraintTop_toTopOf="@id/category_icon"
        app:layout_constraintBottom_toBottomOf="@id/category_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:singleLine="true"
        android:textSize="17sp" />
    <TextView android:id="@+id/label"
        app:layout_constraintStart_toEndOf="@id/category_icon"
        app:layout_constraintTop_toBottomOf="@id/line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:layout_marginStart="5sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="label"/>
    <TextView android:id="@+id/line1"
        app:layout_constraintStart_toEndOf="@id/category_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5sp"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:singleLine="true" android:gravity="center_vertical"
        android:text="line1" android:ellipsize="marquee"/>
</androidx.constraintlayout.widget.ConstraintLayout>
