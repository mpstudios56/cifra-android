<?xml version="1.0" encoding="utf-8"?>
<!--
  One wheel: a digit with a step above and below it.

  The parts were photographs from the time picker of 2011 - a bevelled grey
  button in five states, and a white text field - which on a dark screen looked
  like a piece of another program. Same wheel, same gesture, drawn in the app's
  own colours: the digit on a soft green panel, the steps as chevrons.

  Copyright (c) 2010 Denis Solonenko.
  All rights reserved. This program and the accompanying materials
  are made available under the terms of the GNU Public License v2.0
  which accompanies this distribution, and is available at
  http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <io.github.mpstudios56.cifra.widget.NumberPickerButton
        android:id="@+id/increment"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/wheel_step"
        android:contentDescription="@null"
        android:scaleType="center"
        android:src="@drawable/wheel_up" />

    <EditText
        android:id="@+id/timepicker_input"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/wheel_face"
        android:gravity="center"
        android:inputType="number"
        android:singleLine="true"
        android:textColor="#FFF4EFE4"
        android:textSize="30sp" />

    <io.github.mpstudios56.cifra.widget.NumberPickerButton
        android:id="@+id/decrement"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/wheel_step"
        android:contentDescription="@null"
        android:scaleType="center"
        android:src="@drawable/wheel_down" />

</merge>
