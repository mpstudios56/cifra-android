<?xml version="1.0" encoding="utf-8"?>
<!--
  One entry in a ring: the symbol, and the word under it.

  The word is kept on one line and left to find its own size between nine and
  twelve points. Guessing at widths - shrinking every label, or widening the
  bubble - fixed the longest word on one screen and broke it on the next; this
  way each label measures the room it has been given and fits itself into it.

  Copyright (C) 2010 Cyril Mottier, Apache Licence 2.0.
-->
<androidx.appcompat.widget.AppCompatTextView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	style="@style/GreenDroid.Widget.QuickAction.Grid.Item"

	android:maxLines="1"
	android:ellipsize="end"
	android:gravity="center"
	android:drawablePadding="6dp"
	app:autoSizeTextType="uniform"
	app:autoSizeMinTextSize="9sp"
	app:autoSizeMaxTextSize="12sp"
	app:autoSizeStepGranularity="1sp" />
