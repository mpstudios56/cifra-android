  http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qif_import_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include layout="@layout/filename" />

            <TextView
                style="@style/FormSection"
                android:text="@string/qif_import_shape" />

            <TextView
                style="@style/FormSectionNote"
                android:text="@string/qif_import_shape_note" />

            <TextView
                style="@style/FormFieldLabel"
                android:text="@string/date_format" />

            <Spinner
                android:id="@+id/spinnerDateFormats"
                style="@style/FormSpinner"
                android:entries="@array/qif_date_format_values"
                android:theme="@style/Monospaced" />

            <TextView
                style="@style/FormFieldLabel"
                android:text="@string/currency" />

            <Spinner
                android:id="@+id/spinnerCurrency"
                style="@style/FormSpinner" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/qif_import_disclaimer"
                android:textColor="@color/restored_transaction_color"
                android:textSize="12.5sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/ok_cancel_buttons" />
</LinearLayout>
