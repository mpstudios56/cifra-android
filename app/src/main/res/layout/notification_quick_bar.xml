<?xml version="1.0" encoding="utf-8"?>
<!--
  The three ways of adding something, drawn by us rather than by the system.

  Android gives a notification action no say over its text size, and on a
  narrower phone three of them are cut off mid-word. Drawn here, the labels are
  small enough to be read whole.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/bar_quick"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/quick_transaction"
            android:src="@drawable/actionbar_quick_add" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/quick_transaction"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar_transaction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/transaction"
            android:src="@drawable/icon_transaction" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/transaction"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar_transfer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/transfer"
            android:src="@drawable/icon_transfer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/transfer"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
