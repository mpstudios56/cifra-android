<?xml version="1.0" encoding="utf-8"?>
<!--
  Typing an amount on a movement.

  It was a set of rolling wheels, one per digit, from the Android of 2010: to
  write 12,50 you dragged four columns into place, and on the screen it read as
  a column of numbers with no way in. Everybody types an amount the way a till
  does - digits from the right - which is what the quick entry does two taps
  away, with the same keys as the unlock screen.

  The keys are laid out here rather than built in code, so they can be looked at
  without running the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/calculator_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/keypad_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="end"
        android:singleLine="true"
        android:text="0,00"
        android:textColor="#FFF4EFE4"
        android:textSize="44sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/k7" style="@style/CalcKey" android:text="7" />
        <Button android:id="@+id/k8" style="@style/CalcKey" android:text="8" />
        <Button android:id="@+id/k9" style="@style/CalcKey" android:text="9" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/k4" style="@style/CalcKey" android:text="4" />
        <Button android:id="@+id/k5" style="@style/CalcKey" android:text="5" />
        <Button android:id="@+id/k6" style="@style/CalcKey" android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/k1" style="@style/CalcKey" android:text="1" />
        <Button android:id="@+id/k2" style="@style/CalcKey" android:text="2" />
        <Button android:id="@+id/k3" style="@style/CalcKey" android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/kClear" style="@style/CalcKeyAction" android:text="C" />
        <Button android:id="@+id/k0" style="@style/CalcKey" android:text="0" />
        <Button android:id="@+id/kBack" style="@style/CalcKeyAction" android:text="⌫" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/kCancel"
            style="@style/FormButtonGhost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/kOk"
            style="@style/FormButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ok" />
    </LinearLayout>
</LinearLayout>
