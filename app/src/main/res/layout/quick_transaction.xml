<?xml version="1.0" encoding="utf-8"?>
<!--
  The quick entry screen: an amount, a category, done.

  Deliberately not the full transaction form. Everything that can be assumed is
  assumed - today's date, the chosen account, cleared status - and the keypad is
  on screen so the amount is typed without the system keyboard sliding over half
  the layout.

  Drawn like the unlock keypad, which is the same gesture: the app's own dark
  green, round keys, and the figure large enough to be the subject of the
  screen. The row of shortcuts is outlined rather than filled, so six of them
  read as six choices instead of six grey slabs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF10312A"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <!-- which account, and which way the money is going -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          Outlined, with an arrow after the name: as plain text it read as a
          heading, and nobody thinks of tapping a heading to change the account.
        -->
        <Button
            android:id="@+id/quick_account"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/quick_chip"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="6dp"
            android:drawableTint="#FFF4EFE4"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:text="@string/select_account"
            android:textAllCaps="false"
            android:textColor="#FFF4EFE4"
            android:textSize="15sp" />

        <ToggleButton
            android:id="@+id/quick_sign"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/quick_sign"
            android:minWidth="118dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@null"
            android:textColor="#FFFFFFFF"
            android:textOff="@string/quick_expense"
            android:textOn="@string/quick_income"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- the figure, which is what the screen is for -->
    <TextView
        android:id="@+id/quick_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:singleLine="true"
        android:text="0,00"
        android:textColor="#FFFFFFFF"
        android:textSize="52sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:alpha="0.18"
        android:background="#FFFFFFFF" />

    <!-- what it was for -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.55"
            android:text="@string/category"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/quick_chosen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:singleLine="true"
            android:text="@string/no_category"
            android:textColor="#FF45B87E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      The shortcuts wrap onto a second line rather than scrolling sideways. A
      strip that scrolls leaves the last one sliced in half at the edge, which
      reads as a fault rather than as an invitation to drag; here every one of
      them is whole and in plain sight, "Altre" last among them.
    -->
    <io.github.mpstudios56.cifra.view.FlowLayout
        android:id="@+id/quick_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!--
      The pad is as big as its keys and no bigger. Stretched to fill whatever
      was left it took over half the screen, and the space it wasted is what the
      figure above wanted.
    -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <GridLayout
        android:id="@+id/quick_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:columnCount="3"
        android:rowCount="4" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/quick_save"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/donate_button"
        android:stateListAnimator="@null"
        android:text="@string/save"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
