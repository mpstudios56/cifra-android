<?xml version="1.0" encoding="utf-8"?>
<!--
  A draft: what it was for and what it came to, in the app's own hand.
  It used to be one of Android's stock two-line rows, which is why this screen
  read as somebody else's.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_picked"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@android:id/text1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/ListPrimary" />

    <TextView
        android:id="@android:id/text2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.75"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/ListSecondary" />
</LinearLayout>
