<?xml version="1.0" encoding="utf-8"?>
<!--
  The donation card. Asking for money is the one place in the app where a plain
  list of buttons is not enough: the cup carries the size of what is being asked
  better than the words do, and the accept button is the only coloured one so
  there is never a doubt about which is which.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/donate_image"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/donate"
        android:src="@drawable/ic_coffee" />

    <TextView
        android:id="@+id/donate_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/donate"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/donate_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/donate_summary"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <Button
        android:id="@+id/donate_go"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/donate_button"
        android:text="@string/donate_go"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/donate_later"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/donate_later"
            android:textSize="14sp" />

        <Button
            android:id="@+id/donate_never"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/donate_never"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
