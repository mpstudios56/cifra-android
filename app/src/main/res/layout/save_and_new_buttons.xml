<?xml version="1.0" encoding="utf-8"?>
<!--
  Two ways of saving: the plain one, and the one that saves and opens a fresh
  form. Neither throws anything away, so neither is drawn as the way out.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1A1A1A"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <Button
        android:id="@+id/bSaveAndNew"
        style="@style/FormButtonGhost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:text="@string/save_and_new" />

    <Button
        android:id="@+id/bSave"
        style="@style/FormButtonPrimary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/save" />
</LinearLayout>
