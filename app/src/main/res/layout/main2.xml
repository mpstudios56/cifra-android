<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      One height, always. Left to measure itself the strip came out taller with
      four tabs than with six, which is the opposite of what anybody expects and
      made the bar jump about as tabs were switched on and off in the settings.
      Seventy-two is what a row of symbols with a word under each of them takes,
      and what it took when every tab was on show.
    -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:tabMaxWidth="0dp"
        app:tabGravity="fill"
        app:tabIconTint="@color/tab_icon"
        app:tabIndicatorColor="@color/tab_selected"
        app:tabSelectedTextColor="@color/tab_selected"
        app:tabTextColor="@color/tab_resting"

        app:tabTextAppearance="@style/TabLabel"
        app:tabInlineLabel="false"
        app:tabPaddingStart="1dp"
        app:tabPaddingEnd="1dp"
        android:background="?attr/colorPrimary" />
</LinearLayout>