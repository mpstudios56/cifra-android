<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the assignment screen: a name on the left, a menu on the right.

  Used both for what Cifra worked out about the file and for what each of its
  columns is, so that the two lists look like one thing and not like two.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/csv_map_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <Spinner
        android:id="@+id/csv_map_row_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6" />
</LinearLayout>
