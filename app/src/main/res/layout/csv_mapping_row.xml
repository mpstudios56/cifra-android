<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the assignment screen: a name on the left, a menu on the right.

  Used both for what Cifra worked out about the file and for what each of its
  columns is, so that the two lists look like one thing and not like two.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!--
      Wraps rather than truncating. "Category group" is two short words in
      English and one long one in German, and a label cut off at "Kategorien…"
      tells nobody what the menu beside it is for.
    -->
    <TextView
        android:id="@+id/csv_map_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:paddingEnd="6dp"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <Spinner
        android:id="@+id/csv_map_row_spinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="6" />
</LinearLayout>
