<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:paddingStart="8sp"
	android:paddingEnd="8sp"
	android:paddingBottom="6dp">

	<TextView
		android:id="@+id/top"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingTop="1sp"
		android:singleLine="true"
		android:text="top"
		android:textAppearance="@style/ListSecondary"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<TextView
		android:id="@+id/center"
		android:text="center"
		android:singleLine="true"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textAppearance="@style/ListPrimary"
		android:ellipsize="marquee"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@id/top" />

	<TextView
		android:id="@+id/right_center"
		android:text="right_center"
		android:singleLine="true"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textAppearance="@style/ListPrimary"
		app:layout_constraintBaseline_toBaselineOf="@id/center"
		app:layout_constraintEnd_toEndOf="parent" />

	<TextView
		android:id="@+id/bottom"
		android:text="bottom"
		android:singleLine="true"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:ellipsize="marquee"
		app:layout_constraintTop_toBottomOf="@id/center"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toStartOf="@id/right2" />

	<TextView
		android:id="@+id/right1"
		android:text="right1"
		android:singleLine="true"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:paddingLeft="2sp"
		app:layout_constraintTop_toBottomOf="@id/right_center"
		app:layout_constraintEnd_toEndOf="parent"/>

	<TextView
		android:id="@+id/right"
		android:text="|"
		android:singleLine="true"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textAppearance="?android:attr/textAppearanceSmall"
		android:paddingLeft="2sp"
		app:layout_constraintEnd_toStartOf="@id/right1"
		app:layout_constraintBaseline_toBaselineOf="@id/right1" />

	<TextView
		android:id="@+id/right2"
		android:text="right2"
		android:singleLine="true"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:textAppearance="?android:attr/textAppearanceSmall"
		app:layout_constraintEnd_toStartOf="@id/right"
		app:layout_constraintBaseline_toBaselineOf="@id/right1" />

	<ProgressBar
		android:id="@+id/progress"
		android:progress="0"
		android:max="100"
		android:layout_width="0dp"
		android:layout_height="12dp"
		android:paddingTop="2sp"
		android:paddingBottom="2sp"
		style="@style/ProgressBarBudget"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toBottomOf="@id/bottom" />

	<!--
	  Where the spending should have reached by now. The bar already changed
	  shade at this point, but nothing said what the shade meant: half a budget
	  left on the last day and half left on the first are not the same thing,
	  and only a marked line says which of the two you are looking at.
	-->
	<androidx.constraintlayout.widget.Guideline
		android:id="@+id/today_guide"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		app:layout_constraintGuide_percent="0.5" />

	<View
		android:id="@+id/today_mark"
		android:layout_width="2dp"
		android:layout_height="0dp"
		android:background="#CCFFFFFF"
		android:visibility="gone"
		app:layout_constraintStart_toStartOf="@id/today_guide"
		app:layout_constraintTop_toTopOf="@id/progress"
		app:layout_constraintBottom_toBottomOf="@id/progress" />

	<TextView
		android:id="@+id/today_label"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="1dp"
		android:alpha="0.75"
		android:text="@string/budget_today"
		android:textSize="9sp"
		android:textStyle="bold"
		android:visibility="gone"
		app:layout_constraintStart_toStartOf="@id/today_guide"
		app:layout_constraintEnd_toEndOf="@id/today_guide"
		app:layout_constraintTop_toBottomOf="@id/progress" />

</androidx.constraintlayout.widget.ConstraintLayout>