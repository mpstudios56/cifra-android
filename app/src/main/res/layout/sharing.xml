<?xml version="1.0" encoding="utf-8"?>
<!--
  Sharing a ledger with other people.

  Rewritten rather than rearranged: it had grown a row at a time - me, the
  other person, the folder, the group code, the people - until the setting up
  and the running of it were mixed together and the exchange button had rows
  pressed against it on both sides.

  Two sections now, with a heading each, the way the settings screens read.

  Setting up, in the order somebody actually does it: the folder both phones
  meet in, then what I call myself, then the people and the code shared with
  each. Then the button, with room around it. Then managing: what is being
  shared, movements written down twice, labels to join, and the record.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sharing_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:text="@string/sharing_intro"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <TextView
                style="@style/FormSection"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/sharing_section_setup" />

            <!-- 1. the folder: without it there is nowhere to meet -->
            <LinearLayout
                android:id="@+id/sharing_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sharing_folder"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:id="@+id/sharing_folder_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <!-- 2. what I sign my changes with -->
            <LinearLayout
                android:id="@+id/sharing_me"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <View
                    android:id="@+id/sharing_me_dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sharing_me"
                        android:textAppearance="@style/ListPrimary" />

                    <TextView
                        android:id="@+id/sharing_me_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textAppearance="?android:attr/textAppearanceSmall" />
                </LinearLayout>
            </LinearLayout>

            <!--
              3. the sharings: one per person, each with the code shared with
              them. The plus adds one without going through the list first,
              because on a phone with none there is nothing to go through.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/sharing_people"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sharing_people"
                        android:textAppearance="@style/ListPrimary" />

                    <TextView
                        android:id="@+id/sharing_people_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textAppearance="?android:attr/textAppearanceSmall" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/sharing_people_add"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/holo_dark_button_background"
                    android:contentDescription="@string/sharing_person_add"
                    android:padding="12dp"
                    android:src="@drawable/actionbar_add_big" />
            </LinearLayout>

            <!--
              One row per person: their dot, their name, the code shared with
              them. Held here rather than in a dialog because this is the list
              somebody looks at to see whether the sharing is set up at all.
            -->
            <LinearLayout
                android:id="@+id/sharing_people_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!--
              The exchange, with room around it. It used to have rows pressed
              against it on both sides, which is how somebody presses the wrong
              one.
            -->
            <Button
                android:id="@+id/sharing_now"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/donate_button"
                android:stateListAnimator="@null"
                android:text="@string/sharing_now"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sharing_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.55"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <TextView
                android:id="@+id/sharing_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <TextView
                style="@style/FormSection"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/sharing_section_manage" />

            <LinearLayout
                android:id="@+id/sharing_what"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/share_what"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:id="@+id/sharing_what_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sharing_duplicates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/duplicates"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:id="@+id/sharing_duplicates_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sharing_merge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/merge"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/merge_summary"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sharing_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/change_log"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/change_log_summary"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
