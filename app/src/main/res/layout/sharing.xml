<?xml version="1.0" encoding="utf-8"?>
<!--
  Who the two people are, and what each of them has changed.

  The two rows first, because they are the thing to do here; the note about
  what is not built yet last, where somebody who already knows can skip it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sharing_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="@string/sharing_intro"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <!-- me -->
            <LinearLayout
                android:id="@+id/sharing_me"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <View
                    android:id="@+id/sharing_me_dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/pie_row_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:text="@string/sharing_me"
                        android:textAllCaps="true"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/sharing_me_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textAppearance="@style/ListPrimary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/sharing_me_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- them -->
            <LinearLayout
                android:id="@+id/sharing_them"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <View
                    android:id="@+id/sharing_them_dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/pie_row_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.6"
                        android:text="@string/sharing_them"
                        android:textAllCaps="true"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/sharing_them_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textAppearance="@style/ListPrimary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/sharing_them_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.15"
                android:background="#FFFFFFFF" />

            <!--
              Where the two phones will meet. Chosen now even though nothing is
              written there yet: it is the one decision that has to be the same
              on both phones, and making it early means it is already right when
              the exchange arrives.
            -->
            <LinearLayout
                android:id="@+id/sharing_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sharing_folder"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:id="@+id/sharing_folder_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>



            <!--
              The round happens on its own when the screen opens; the button is
              for the moment somebody is standing there waiting for it, which is
              exactly when a wait of thirty seconds feels like a fault.
            -->
            <Button
                android:id="@+id/sharing_now"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/donate_button"
                android:stateListAnimator="@null"
                android:text="@string/sharing_now"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />

            <!--
              What this phone writes under. The first thing anybody does when
              the exchange looks stuck is open the folder on a computer, and
              until this was here they had nothing to look for.
            -->
            <TextView
                android:id="@+id/sharing_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.55"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <TextView
                android:id="@+id/sharing_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.15"
                android:background="#FFFFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:text="@string/sharing_functions"
                android:textAllCaps="true"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/sharing_what"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/share_what"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:id="@+id/sharing_what_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sharing_duplicates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/duplicates"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:id="@+id/sharing_duplicates_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sharing_merge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/merge"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/merge_intro"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sharing_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/change_log"
                    android:textAppearance="@style/ListPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="@string/change_log_summary"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.7"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/sharing_not_yet"
                android:textAppearance="?android:attr/textAppearanceSmall" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
