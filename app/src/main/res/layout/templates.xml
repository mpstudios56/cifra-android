<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
	a:layout_height="fill_parent" a:layout_width="fill_parent"
	a:orientation="vertical">
	<!--
	  The search at the top, in the app's own field, and the buttons at the foot
	  in the app's own hand: this screen still wore the platform's grey slabs and
	  an English hint nobody had translated.
	-->
	<EditText
		a:id="@+id/searchFilter"
		a:layout_width="match_parent"
		a:layout_height="wrap_content"
		a:layout_margin="10dp"
		a:hint="@string/search_hint"
		a:maxLines="1"
		a:inputType="text" />

	<ListView
		a:id="@android:id/list"
		a:layout_width="match_parent"
		a:layout_height="match_parent"
		a:layout_weight="1"></ListView>
	<TextView a:id="@id/android:empty" a:layout_width="fill_parent"
		a:layout_weight="1" a:gravity="center" a:text="@string/no_transactions"
		a:layout_height="?android:attr/listPreferredItemHeight" />

	<LinearLayout a:layout_height="wrap_content"
		a:layout_width="fill_parent" style="@style/ButtonBar">
		<Button a:id="@+id/bEditTemplates"
			a:layout_height="wrap_content"
			a:layout_width="0dp"
			a:layout_weight="1"
			a:layout_margin="6dp"
			style="@style/FormButtonGhost"
			a:text="@string/edit" />
		<ImageButton a:layout_width="wrap_content"
			a:layout_height="wrap_content" style="@style/MinusButton"
			a:id="@+id/bMinus" a:layout_marginLeft="10dp" />
		<TextView a:layout_width="wrap_content"
			a:layout_height="wrap_content" a:id="@+id/multiplier"
			a:text="x1" a:textStyle="bold" a:textColor="#FFF4EFE4" a:textSize="16sp"></TextView>
		<ImageButton a:layout_width="wrap_content"
			a:layout_height="wrap_content" style="@style/PlusButton"
			a:id="@+id/bPlus" a:layout_marginRight="10dp" />
		<Button a:id="@+id/bCancel"
			a:layout_height="wrap_content"
			a:layout_width="0dp"
			a:layout_weight="1"
			a:layout_margin="6dp"
			style="@style/FormButtonGhost"
			a:text="@string/cancel" />
	</LinearLayout>


</LinearLayout>
