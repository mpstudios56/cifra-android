  http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/calculator_background"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:text="0"
            android:textColor="#FFF4EFE4"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/op"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:text=""
            android:textColor="#FF45B87E"
            android:textSize="20sp" />
    </RelativeLayout>

    <!-- the memory row, quieter than the digits: it is used once in a hundred times -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bSTO"
            style="@style/CalcKeySmall"
            android:text="STO" />

        <Button
            android:id="@+id/bX"
            style="@style/CalcKeySmall"
            android:text="X" />

        <Button
            android:id="@+id/bY"
            style="@style/CalcKeySmall"
            android:text="Y" />

        <Button
            android:id="@+id/bZ"
            style="@style/CalcKeySmall"
            android:text="Z" />

        <Button
            android:id="@+id/bT"
            style="@style/CalcKeySmall"
            android:text="T" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/b7" style="@style/CalcKey" android:text="7" />
        <Button android:id="@+id/b8" style="@style/CalcKey" android:text="8" />
        <Button android:id="@+id/b9" style="@style/CalcKey" android:text="9" />
        <Button android:id="@+id/bDivide" style="@style/CalcKeyAction" android:text="÷" />
        <Button android:id="@+id/bClear" style="@style/CalcKeyAction" android:text="C" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/b4" style="@style/CalcKey" android:text="4" />
        <Button android:id="@+id/b5" style="@style/CalcKey" android:text="5" />
        <Button android:id="@+id/b6" style="@style/CalcKey" android:text="6" />
        <Button android:id="@+id/bMultiply" style="@style/CalcKeyAction" android:text="×" />
        <Button android:id="@+id/bDelete" style="@style/CalcKeyAction" android:text="⌫" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/b1" style="@style/CalcKey" android:text="1" />
        <Button android:id="@+id/b2" style="@style/CalcKey" android:text="2" />
        <Button android:id="@+id/b3" style="@style/CalcKey" android:text="3" />
        <Button android:id="@+id/bSubtract" style="@style/CalcKeyAction" android:text="−" />
        <Button android:id="@+id/bPercent" style="@style/CalcKeyAction" android:text="%" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/b0" style="@style/CalcKey" android:text="0" />
        <Button android:id="@+id/bDot" style="@style/CalcKey" android:text="," />
        <Button android:id="@+id/bPlusMinus" style="@style/CalcKey" android:text="±" />
        <Button android:id="@+id/bAdd" style="@style/CalcKeyAction" android:text="+" />
        <Button android:id="@+id/bResult" style="@style/CalcKeyEquals" android:text="=" />
    </LinearLayout>
</LinearLayout>
