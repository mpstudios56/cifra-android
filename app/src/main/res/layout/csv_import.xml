-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/csv_import_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <include layout="@layout/filename" />

            <TextView
                style="@style/FormSection"
                android:text="@string/csv_import_account_selector" />

            <TextView
                style="@style/FormSectionNote"
                android:text="@string/csv_import_account_note" />

            <Spinner
                android:id="@+id/spinnerAccount"
                style="@style/FormSpinner"
                android:prompt="@string/account" />

            <TextView
                style="@style/FormSection"
                android:text="@string/csv_import_shape" />

            <TextView
                style="@style/FormSectionNote"
                android:text="@string/csv_import_shape_note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/decimals" />

                    <Spinner
                        android:id="@+id/spinnerDecimals"
                        style="@style/FormSpinner"
                        android:entries="@array/decimals"
                        android:theme="@style/Monospaced" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/decimal_separator" />

                    <Spinner
                        android:id="@+id/spinnerDecimalSeparators"
                        style="@style/FormSpinner"
                        android:entries="@array/decimal_separators"
                        android:theme="@style/Monospaced" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/group_separator" />

                    <Spinner
                        android:id="@+id/spinnerGroupSeparators"
                        style="@style/FormSpinner"
                        android:entries="@array/group_separators"
                        android:theme="@style/Monospaced" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/field_separator" />

                    <Spinner
                        android:id="@+id/spinnerFieldSeparator"
                        style="@style/FormSpinner"
                        android:entries="@array/field_separators"
                        android:theme="@style/Monospaced" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormFieldLabel"
                        android:text="@string/date_format" />

                    <Spinner
                        android:id="@+id/spinnerDateFormats"
                        style="@style/FormSpinner"
                        android:entries="@array/date_format_values"
                        android:theme="@style/Monospaced" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbUseHeaderFromFile"
                style="@style/FormCheckBox"
                android:text="@string/use_header_from_file" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/ok_cancel_buttons" />
</LinearLayout>
