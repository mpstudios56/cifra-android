<?xml version="1.0" encoding="utf-8"?>
<!--
  The one screen shown before anything else, and only once.

  It asks two things and no more. Both are things nobody goes looking for in the
  settings, and both are worth more on the first day than on any later one: a
  backup that was never switched on protects nothing, and an empty app explains
  nothing about what it is for.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/welcome_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/welcome_subtitle"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <!-- backup -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:alpha="0.2"
            android:background="#FFFFFFFF" />

        <CheckBox
            android:id="@+id/welcome_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="@string/welcome_backup"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:text="@string/welcome_backup_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/welcome_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:text="@string/welcome_choose_folder" />

        <!-- sample data -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:alpha="0.2"
            android:background="#FFFFFFFF" />

        <CheckBox
            android:id="@+id/welcome_demo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/welcome_demo"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:text="@string/welcome_demo_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/welcome_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/donate_button"
            android:text="@string/welcome_start"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
