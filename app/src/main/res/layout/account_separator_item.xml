<?xml version="1.0" encoding="utf-8"?>
<!--
  A heading in the list of accounts. Not a row about money: no symbol, no
  figure, no balance - a word in green with a line beside it, and a mark saying
  whether what follows is folded away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/separator_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/listChoiceBackgroundIndicator"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/separator_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#FF4CAF7D"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/separator_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="#8CF4EFE4"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/separator_fold"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_fold_years" />
</LinearLayout>
