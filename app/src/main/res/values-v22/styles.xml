<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Every list that opens over a screen - which account, which category, which
      state. It was a hard-edged grey slab with blue words at the foot; the same
      rounded dark card as the rest of the app, and the app's green on the two
      answers.
    -->
    <style name="AppTheme.Dialog.Alert" parent="@style/Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">#FF4CAF7D</item>
        <item name="colorAccent">#FF4CAF7D</item>
        <item name="android:textColorPrimary">#FFF4EFE4</item>
        <item name="android:textColorSecondary">#B3F4EFE4</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogAnswerPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogAnswerGhost</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogAnswerGhost</item>
    </style>


    <style name="AppTheme" parent="android:Theme.Holo">
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog.Alert</item>
        <item name="android:buttonStyle">@style/Button</item>
        <item name="android:imageButtonStyle">@android:style/Widget.Holo.Light.ImageButton</item>
        <item name="android:spinnerItemStyle">@style/TextViewSpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/TextViewSpinnerDropDownItem</item>
        <item name="android:windowBackground">@android:color/black</item>
        <!--
          The calendar and the clock that set the date and the time of a
          movement. This is the theme phones actually run - the one in values/
          is shadowed by it - so this is where they have to be named.
        -->
        <item name="android:datePickerDialogTheme">@style/CifraDatePickerDialog</item>
        <item name="android:timePickerDialogTheme">@style/CifraTimePickerDialog</item>
    </style>

    <style name="Button" parent="@android:style/Widget.Holo.Light.Button">
        <item name="android:textColor">@android:color/primary_text_dark</item>
    </style>

    <style name="Monospaced" parent="AppTheme">
        <item name="android:fontFamily">monospace</item>
        <item name="android:spinnerDropDownItemStyle">@style/TextViewSpinnerDropDownItemMonospace</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog.Alert</item>
        <item name="android:spinnerDropDownItemStyle">@style/TextViewSpinnerDropDownItem</item>
    </style>

    <style name="AppCompatDialog" parent="@style/Theme.AppCompat.Dialog">
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog.Alert</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
      Every box that opens over one of the screens built on this theme - the
      planner, the templates, the lists that ask a question. They were square
      grey rectangles while the rest of the app had been rounded; the corners
      are the same as everywhere else now, and the two answers carry the app’s
      green.
    -->
    <style name="AppThemeCompat.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="colorAccent">#FF4CAF7D</item>
        <item name="android:textColorPrimary">#FFF4EFE4</item>
    </style>

    <style name="AppThemeCompat.Dialog.Alert" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="colorAccent">#FF4CAF7D</item>
        <item name="android:textColorPrimary">#FFF4EFE4</item>
        <item name="android:textColorSecondary">#B3F4EFE4</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogAnswerPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogAnswerGhost</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogAnswerGhost</item>
    </style>

    <style name="AppThemeCompat" parent="@style/Theme.AppCompat.NoActionBar">
        <!--
          Everything Android draws for itself in its own colour - the ticks, the
          switches, the writing cursor, the line under a field being typed in -
          took the electric blue it comes with, in an app that is green
          everywhere a person put a colour. Said once here rather than fought
          with field by field.
        -->
        <item name="colorAccent">#FF4CAF7D</item>
        <item name="colorControlActivated">#FF4CAF7D</item>
        <item name="colorControlHighlight">#26FFFFFF</item>
        <item name="android:textColorHighlight">#4D4CAF7D</item>
        <item name="android:dialogTheme">@style/AppThemeCompat.Dialog</item>
        <item name="android:alertDialogTheme">@style/AppThemeCompat.Dialog.Alert</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@color/background_material_dark</item>

        <item name="android:fastScrollThumbDrawable">@drawable/thumb_drawable</item>
        <item name="android:fastScrollTrackDrawable">@drawable/line_drawable</item>
    </style>

    <style name="Caption" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Synonym" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textColor">?android:attr/textColorTertiary</item>
    </style>

    <style name="LightSpinner" parent="@style/AppTheme">
        <item name="android:spinnerItemStyle">@style/LightSpinnerItem</item>
    </style>

    <style name="LightSpinnerItem" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">@android:color/primary_text_light</item>
    </style>
</resources>