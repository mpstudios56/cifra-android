<resources>
	<!-- The platform theme this inherits is Material from 2014: its popups and
	     dialogs are hard-edged rectangles. Rounding them is all that separates
	     them from what the rest of the app now looks like. -->
    <!--
      The bar that appears while rows are picked. Left to itself it came out in
      the platform's colours - a teal nothing else in this app uses - with a
      dark symbol on a dark ground.
    -->
    <style name="Cifra.ActionMode" parent="@android:style/Widget.Material.ActionMode">
        <item name="android:background">#FF26282B</item>
        <item name="android:titleTextStyle">@style/Cifra.ActionMode.Title</item>
    </style>

    <style name="Cifra.ActionMode.Title" parent="@android:style/TextAppearance.Material.Widget.ActionMode.Title">
        <item name="android:textColor">#FFF4EFE4</item>
    </style>

	<style name="AppTheme" parent="android:Theme.Material">
        <item name="android:actionModeStyle">@style/Cifra.ActionMode</item>
		<item name="android:popupMenuStyle">@style/AppPopupMenu</item>
		<item name="android:alertDialogTheme">@style/AlertDialog</item>
		<item name="android:datePickerDialogTheme">@style/CifraDatePickerDialog</item>
		<item name="android:timePickerDialogTheme">@style/CifraTimePickerDialog</item>
		<!--
		  The screens that still use the platform's own title bar - the budget,
		  the category, the account - were showing the app's icon beside the
		  title, which is the shape of an Android screen from 2013 and appears
		  nowhere else in the app. The title on its own, like the screens with
		  a toolbar of their own.
		-->
		<item name="android:actionBarStyle">@style/AppActionBar</item>
	</style>
	<style name="AppActionBar" parent="android:Widget.Material.ActionBar">
		<item name="android:displayOptions">showTitle</item>
		<item name="android:background">#FF1A1A1A</item>
		<item name="android:elevation">0dp</item>
	</style>
	<style name="AppPopupMenu" parent="android:Widget.Material.PopupMenu">
		<item name="android:popupBackground">@drawable/popup_menu_background</item>
	</style>
	<style name="AppDialog" parent="android:Theme.Material.Dialog">
		<item name="android:windowBackground">@drawable/dialog_background</item>
	</style>
	<style name="AlertDialog" parent="android:Theme.Material.Dialog">
		<item name="android:windowBackground">@drawable/dialog_background</item>
	</style>
	<!--
	  The calendar that picks the date of a movement.
	  It came dressed in the platform's own colours - a blue head, a blue ring
	  round today - on a white card, which is nothing like the rest of the app.
	  Same rounded dark card as every other dialog, and the app's green where
	  the blue was. The hands of the clock are left as they are.
	-->
	<!--
	  A list one ticks through - which accounts are the everyday ones, and any
	  other question answered with more than one mark. The platform draws it as
	  a grey slab with blue ticks; this is the app's card, and the app's green.
	-->
	<style name="CifraChoiceDialog" parent="@style/Theme.MaterialComponents.Dialog.Alert">
		<item name="android:windowBackground">@drawable/dialog_background</item>
		<item name="colorAccent">#FF4CAF7D</item>
		<item name="colorSecondary">#FF4CAF7D</item>
		<item name="colorControlActivated">#FF4CAF7D</item>
		<item name="android:colorControlActivated">#FF4CAF7D</item>
		<item name="android:textColorPrimary">#FFF4EFE4</item>
		<item name="android:textColorSecondary">#B3F4EFE4</item>
		<item name="buttonBarPositiveButtonStyle">@style/DialogAnswer</item>
		<item name="buttonBarNegativeButtonStyle">@style/DialogAnswer</item>
	</style>

	<style name="DialogAnswer" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
		<item name="android:textColor">#FF4CAF7D</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textStyle">bold</item>
	</style>

	<style name="CifraDatePickerDialog" parent="android:Theme.Material.Dialog">
		<item name="android:windowBackground">@drawable/dialog_background</item>
		<item name="android:colorAccent">#FF4CAF7D</item>
		<item name="android:datePickerStyle">@style/CifraDatePicker</item>
	</style>
	<style name="CifraDatePicker" parent="android:Widget.Material.DatePicker">
		<item name="android:datePickerMode">calendar</item>
		<item name="android:headerBackground">#FF303030</item>
		<item name="android:textColorPrimary">#FFF4EFE4</item>
		<item name="android:textColorSecondary">#B3F4EFE4</item>
	</style>
	<!--
	  And the clock that sets the time, on the same ground: the dial came in the
	  platform's blue on a pale disc, next to a calendar that no longer does.
	-->
	<style name="CifraTimePickerDialog" parent="android:Theme.Material.Dialog">
		<item name="android:windowBackground">@drawable/dialog_background</item>
		<item name="android:colorAccent">#FF4CAF7D</item>
		<item name="android:timePickerStyle">@style/CifraTimePicker</item>
	</style>
	<style name="CifraTimePicker" parent="android:Widget.Material.TimePicker">
		<item name="android:headerBackground">#FF303030</item>
		<item name="android:numbersBackgroundColor">#FF262626</item>
		<item name="android:numbersSelectorColor">#FF4CAF7D</item>
		<item name="android:numbersTextColor">#FFF4EFE4</item>
		<item name="android:numbersInnerTextColor">#B3F4EFE4</item>
	</style>
	<style name="CalculatorDialog" parent="android:Theme.Material.Dialog" />

	<style name="CupcakeDialog" parent="android:Theme.Material.Dialog">
    	<item name="android:windowAnimationStyle">@null</item>
    </style>
	<style name="EditDivider">
		<item name="android:background">@drawable/divider_horizontal_dark</item>
	</style>
	<style name="TextAppearance" parent="android:TextAppearance.Small">
		<item name="android:textStyle">normal</item>
		<item name="android:antialias">true</item>
		<item name="android:textColor">#FF000000</item>
	</style>
    <style name="TextAppearance.ZeroAmount">
        <item name="android:textColor">@android:color/secondary_text_dark</item>
    </style>
	<style name="TextAppearance.PositiveAmount" parent="android:TextAppearance.Small">
		<item name="android:textColor">#39b54a</item>
	</style>
	<style name="TextAppearance.NegativeAmount" parent="android:TextAppearance.Small">
		<item name="android:textColor">#f26522</item>
	</style>
    <style name="TextAppearance.BalanceAmount" parent="android:TextAppearance.Small">
        <item name="android:textColor">#737373</item>
		<item name="android:textSize">12sp</item>
    </style>
	<!-- Small enough for the longest word in the longest language to fit under
	     its icon: Ubersicht and Benachrichtigungen are not short. -->
	<style name="TabLabel" parent="android:TextAppearance.Small">
		<item name="android:textSize">9sp</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<style name="ListPrimary" parent="android:TextAppearance.Medium">
		<item name="android:textSize">16sp</item>
	</style>
	<style name="ListSecondary" parent="android:TextAppearance.Small">
		<item name="android:textSize">12sp</item>
	</style>
	<!--
	  The foot of a form. One filled button for the action the screen exists
	  for, one outline for the way out: they used to be two identical grey
	  slabs, and the one that saves looked exactly like the one that discards.
	-->
	<!--
	  The pieces a form is built from, so the import screens, the export
	  screens and the settings all read the same way: a heading, a line of
	  small type under it, then the controls.
	-->
	<!--
	  The calculator keys: circles, like the quick entry keypad and the unlock
	  keypad, because all three are a digit typed with a thumb.
	-->
	<!--
	  Fixed sizes, not proportions: the keypad lives in a window that fits
	  itself to its contents, and a key asking for a share of the width there
	  measures zero. Everything disappeared and only the figure was left.
	-->
	<style name="CalcKey">
		<item name="android:layout_width">62dp</item>
		<item name="android:layout_height">62dp</item>
		<item name="android:layout_margin">4dp</item>
		<item name="android:background">@drawable/calc_key</item>
		<item name="android:textColor">#FFF4EFE4</item>
		<item name="android:textSize">22sp</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:minWidth">0dp</item>
		<item name="android:minHeight">0dp</item>
	</style>
	<style name="CalcKeyAction" parent="@style/CalcKey">
		<item name="android:background">@drawable/calc_key_action</item>
	</style>
	<style name="CalcKeyEquals" parent="@style/CalcKey">
		<item name="android:background">@drawable/form_button_primary</item>
		<item name="android:textColor">#FFFFFFFF</item>
		<item name="android:textStyle">bold</item>
	</style>
	<style name="CalcKeySmall" parent="@style/CalcKey">
		<item name="android:layout_width">58dp</item>
		<item name="android:layout_height">40dp</item>
		<item name="android:textSize">13sp</item>
		<item name="android:alpha">0.75</item>
	</style>
	<style name="FormSection">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">24dp</item>
		<item name="android:textSize">16sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textColor">#FFF4EFE4</item>
	</style>
	<style name="FormSectionNote">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginBottom">10dp</item>
		<item name="android:alpha">0.55</item>
		<item name="android:textSize">12.5sp</item>
	</style>
	<style name="FormFieldLabel">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<!-- two lines' worth whatever the label says, so boxes side by side
		     start at the same height even when one name wraps -->
		<item name="android:minLines">2</item>
		<item name="android:gravity">bottom</item>
		<item name="android:layout_marginTop">10dp</item>
		<item name="android:layout_marginBottom">3dp</item>
		<item name="android:alpha">0.55</item>
		<item name="android:textSize">11.5sp</item>
	</style>
	<style name="FormSpinner">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:background">@drawable/form_field</item>
		<item name="android:minHeight">46dp</item>
		<item name="android:paddingStart">12dp</item>
		<!-- room for the chevron drawn into the background -->
		<item name="android:paddingEnd">36dp</item>
	</style>
	<style name="FormCheckBox">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">14dp</item>
		<item name="android:minHeight">44dp</item>
		<item name="android:paddingStart">8dp</item>
		<item name="android:textSize">14sp</item>
	</style>
	<style name="FormButtonPrimary" parent="android:Widget.Material.Button">
		<item name="android:background">@drawable/form_button_primary</item>
		<item name="android:textColor">#FFFFFFFF</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">15sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:minHeight">48dp</item>
		<item name="android:stateListAnimator">@null</item>
		<item name="android:elevation">0dp</item>
	</style>
	<style name="FormButtonGhost" parent="@style/FormButtonPrimary">
		<item name="android:background">@drawable/form_button_ghost</item>
		<item name="android:textColor">#FFF4EFE4</item>
		<item name="android:textStyle">normal</item>
	</style>
	<!--
	  The date and the time of a movement, and the two answers at the foot of
	  the filters. They were the platform button of 2011 - a grey slab with a
	  shadow - sitting under fields drawn this year.
	-->
	<style name="TransactionDateTimeButton" parent="@style/FormButtonGhost">
		<item name="android:minHeight">44dp</item>
		<item name="android:paddingLeft">10dp</item>
		<item name="android:paddingRight">10dp</item>
		<item name="android:layout_margin">3dp</item>
	</style>
	<style name="LockScreenButton" parent="@android:style/Widget.Button">
		<item name="android:layout_width">@dimen/pin_button_width</item>
		<item name="android:layout_height">@dimen/pin_button_height</item>
		<item name="android:background">@drawable/pin_key</item>
		<item name="android:textColor">#FFFFFFFF</item>
		<item name="android:textSize">26sp</item>
		<item name="android:stateListAnimator">@null</item>
	</style>
	<style name="BorderlessButton">
		<item name="android:background">@android:drawable/list_selector_background</item>
		<item name="android:paddingLeft">4dip</item>
		<item name="android:paddingRight">4dip</item>
		<item name="android:textSize">14sp</item>
	</style>
	<style name="ListButton" parent="BorderlessButton">
		<item name="android:minHeight">40dip</item>
		<item name="android:minWidth">40dip</item>
		<item name="android:focusable">false</item>
		<item name="android:focusableInTouchMode">false</item>
		<item name="android:tint">@color/colorPrimary</item>
	</style>
	<style name="WhiteListButton" parent="ListButton">
		<item name="android:tint">@color/holo_gray_light</item>
	</style>
	<style name="MinusButton">
		<item name="android:background">@drawable/btn_circle</item>
		<item name="android:src">@drawable/ic_btn_round_minus</item>
	</style>
	<style name="PlusButton">
		<item name="android:background">@drawable/btn_circle</item>
		<item name="android:src">@drawable/ic_btn_round_plus</item>
	</style>
	<style name="MoreButton">
		<item name="android:background">@drawable/btn_circle</item>
		<item name="android:src">@drawable/ic_btn_round_more</item>
	</style>
    <style name="SplitButton">
        <item name="android:background">@drawable/btn_circle</item>
        <item name="android:src">@drawable/ic_btn_round_split</item>
    </style>
	<style name="TransferButton" parent="ListButton">
		<item name="android:src">@drawable/ic_action_transfer</item>
	</style>
	<style name="UpButton">
		<item name="android:background">@drawable/btn_circle</item>
		<item name="android:src">@drawable/ic_btn_round_up</item>
	</style>
	<style name="DownButton">
		<item name="android:background">@drawable/btn_circle</item>
		<item name="android:src">@drawable/ic_btn_round_down</item>
	</style>
	<style name="TopButton">
		<item name="android:background">@drawable/btn_circle</item>
		<item name="android:src">@drawable/ic_btn_round_top</item>
	</style>
	<style name="BottomButton">
		<item name="android:background">@drawable/btn_circle</item>
		<item name="android:src">@drawable/ic_btn_round_bottom</item>
	</style>
    <style name="UpDownButton">
        <item name="android:background">@drawable/btn_circle2</item>
        <item name="android:src">@drawable/expand_all</item>
    </style>
    <style name="CalcButton">
        <item name="android:background">@drawable/btn_circle2</item>
        <item name="android:src">@drawable/equal</item>
    </style>
	<style name="PaletteButton">
		<item name="android:background">@drawable/btn_circle2</item>
		<item name="android:src">@drawable/palette</item>
		<item name="android:tint">#ff5c5c5c</item>
	</style>
	<style name="KeypadButton">
		<item name="android:background">@drawable/btn_circle2</item>
		<item name="android:src">@drawable/apps</item>
		<item name="android:tint">#ff5c5c5c</item>
	</style>
	<style name="CameraButton">
		<item name="android:background">@drawable/btn_circle2</item>
		<item name="android:src">@drawable/photo_camera</item>
		<item name="android:tint">#ff5c5c5c</item>
	</style>
	<style name="PhotoAlbumButton">
		<item name="android:background">@drawable/btn_circle2</item>
		<item name="android:src">@drawable/photo_album</item>
		<item name="android:tint">#ff5c5c5c</item>
	</style>
	<style name="DownloadButton" parent="ListButton">
		<item name="android:src">@drawable/material_download</item>
	</style>

	<style name="TallTitleBarTheme" parent="android:Theme.NoTitleBar">
		<item name="android:windowContentOverlay">@null</item>
	</style>

	<style name="BottomBarButton">
		<item name="android:background">@drawable/holo_dark_button_background</item>
		<item name="android:textColor">@android:color/primary_text_light</item>
		<item name="android:layout_width">@dimen/action_button_size</item>
		<item name="android:layout_height">@dimen/action_button_size</item>
		<item name="android:layout_marginTop">@dimen/action_button_margin</item>
		<item name="android:layout_marginBottom">@dimen/action_button_margin</item>
		<item name="android:layout_marginLeft">@dimen/action_button_margin</item>
		<item name="android:layout_marginRight">0sp</item>
	</style>
	<style name="BlotterButtonBar">
		<item name="android:background">#FFF</item>
	</style>
	<style name="MassOpActionDropdown">
		<item name="android:background">#FFF</item>
	</style>
	<style name="ButtonBar"> 
		<item name="android:paddingTop">5dip</item> 
		<item name="android:paddingLeft">4dip</item> 
		<item name="android:paddingRight">4dip</item> 
		<item name="android:paddingBottom">1dip</item> 
		<item name="android:background">@android:drawable/bottom_bar</item> 
	</style>
	<style name="ImageButtonOnDarkBackground" parent="@android:style/Widget.ImageButton" />
	<style name="WhiteBackgroundButtonBar" parent="@style/ButtonBar">
		<item name="android:layout_width">fill_parent</item>
		<item name="android:layout_height">wrap_content</item>
	</style>
	<style name="ProgressBarBudget" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_horizontal_budget</item>
        <item name="android:minHeight">12dip</item>
        <item name="android:maxHeight">12dip</item>
    </style>
	<style name="EntityEnumListItemText">
		<item name="android:textColor">@android:color/primary_text_dark</item>
	</style>
	<style name="SelectableItem">
		<item name="android:background">@android:drawable/list_selector_background</item>
	</style>

	<style name="ContactListSeparatorTextViewStyle">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginTop">8dip</item>
		<!-- See comments for @dimen/list_section_divider_min_height -->
		<item name="android:minHeight">@dimen/list_section_divider_min_height</item>
		<item name="android:background">@drawable/list_section_divider_holo_custom</item>
		<item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textColor">@color/colorPrimary</item>
		<item name="android:gravity">center_vertical</item>
		<item name="android:paddingLeft">8dip</item>
		<item name="android:ellipsize">end</item>
		<item name="android:fadingEdge">horizontal</item>
		<item name="android:singleLine">true</item>
		<item name="android:textAllCaps">true</item>
	</style>

    <style name="LockButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minHeight">@dimen/pin_button_height</item>
        <item name="android:minWidth">@dimen/pin_button_width</item>
        <item name="android:textSize">30sp</item>
    </style>
</resources>
