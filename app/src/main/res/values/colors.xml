<resources>
    <color name="colorPrimary">@color/material_blue_gray</color>
    <color name="colorPrimaryDark">@color/material_blue_gray</color>
    <color name="colorAccent">@color/material_blue_gray</color>
    <color name="holo_blue_light">#ff33b5e5</color>
    <color name="holo_gray_light">#33999999</color>
    <color name="holo_gray_dark">#323232</color>
    <color name="holo_green_light">#ff99cc00</color>
    <color name="holo_red_light">#ffff4444</color>
    <color name="holo_blue_dark">#ff0099cc</color>
    <color name="holo_green_dark">#ff669900</color>
    <color name="holo_red_dark">#ffcc0000</color>
    <color name="holo_purple">#ffaa66cc</color>
    <color name="holo_orange_light">#ffffbb33</color>
    <color name="holo_orange_dark">#ffff9800</color>
    <color name="holo_blue_bright">#ff00ddff</color>
    <color name="holo_gray_bright">#FFCCCCCC</color>
    <color name="material_orange">#F4511E</color>
    <color name="material_teal">#009688</color>
    <color name="material_blue_gray">#546E7A</color>
    <color name="material_cyan">#00BCD4</color>
    <color name="material_brown">#795548</color>
    <!-- The keypad sits on the app's own dark, not on the mid-grey of a 2010 dialog. -->
    <color name="calculator_background">#FF141414</color>

    <color name="button_tint">#757575</color>

    <color name="transaction_category">@android:color/primary_text_dark</color>
    <color name="transaction_note">@android:color/secondary_text_dark</color>
    <color name="transaction_payee">@android:color/holo_blue_light</color>
    <color name="transaction_location">@android:color/holo_green_light</color>
    <color name="transaction_date">#999</color>
    <color name="transaction_date_weekend">#c66</color>

    <color name="currency_symbol">@android:color/holo_orange_light</color>
    <color name="currency_title">@android:color/secondary_text_dark</color>

    <color name="draft_background">#40ffbb33</color>

    <color name="highlight_background">#ff052029</color>
    <!-- The quick menu bubble. Light on purpose: the icons inside are forced to
         black in MyQuickAction, so a dark bubble would swallow them. -->
    <!-- The bubble that opens on a long press. Dark, like everything
         else in this app: it was the one surface left white, with black
         icons on it, and it read as a piece of another program. -->
    <color name="quick_action_surface">#FF2B2B2B</color>
</resources>